  m_Name: QuitDuringSaveWarning
  m_EditorClassIdentifier: 
  Strings:
    Com: 0x515549545F5748494C455F534156455F455252
    Kor: "\uC800\uC7A5 \uC911 \uAC8C\uC784\uC744 \uC885\uB8CC\uD560 \uACBD\uC6B0 \uC624\uB958\uAC00 \uBC1C\uC0DD\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    Eng: Quitting the game while saving may cause errors.
    Chs: "\u4FDD\u5B58\u8FC7\u7A0B\u4E2D\u9000\u51FA\u6E38\u620F\u53EF\u80FD\u4F1A\u5BFC\u81F4\u9519\u8BEF\u3002"
    Cht: "\u5132\u5B58\u904E\u7A0B\u4E2D\u9000\u51FA\u904A\u6232\u53EF\u80FD\u6703\u5C0E\u81F4\u932F\u8AA4\u3002"
    Jpn: "\u4FDD\u5B58\u4E2D\u306B\u30B2\u30FC\u30E0\u3092\u7D42\u4E86\u3059\u308B\u3068\u3001\u30A8\u30E9\u30FC\u304C\u767A\u751F\u3059\u308B\u53EF\u80FD\u6027\u304C\u3042\u308A\u307E\u3059\u3002"

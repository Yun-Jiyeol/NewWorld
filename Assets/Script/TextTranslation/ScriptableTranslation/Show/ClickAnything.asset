    Chs: "\u6B63\u5728\u7B49\u5F85\u7528\u6237\u54CD\u5E94\u3002\u8BF7\u53D1\u9001\u4EFB\u610F\u8F93\u5165\u3002"
    Cht: "\u6B63\u5728\u7B49\u5F85\u4F7F\u7528\u8005\u56DE\u61C9\u3002\u8ACB\u50B3\u9001\u4EFB\u610F\u8F38\u5165\u3002"
    Jpn: "\u30e6\u30fc\u30b6\u30fc\u306e\u5fdc\u7b54\u3092\u5f85\u3063\u3066\u3044\u307e\u3059\u3002\u4efb\u610f\u306e\u5165\u529b\u3092\u9001\u4fe1\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
